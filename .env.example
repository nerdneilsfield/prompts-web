# Copy to .env and fill in real values. .env is git-ignored.
# Every variable the server reads is listed here; nothing else is configurable.
# The .env file holds the site password and the model key — keep it readable
# only by the account that runs the service (chmod 600 .env).

# --- required -----------------------------------------------------------------

# Single site password. Anyone with it can read and edit the whole library.
APP_PASSWORD=change-me-please

# Public origin the browser uses. Scheme decides the cookie's Secure flag:
# https -> Secure session cookie, http -> plain (local debugging only).
APP_ORIGIN=https://prompts.example.com

# --- listening and storage ----------------------------------------------------

# Container deployments must keep 0.0.0.0:8080. Local non-container default is
# 127.0.0.1:8080, so loopback-only unless you deliberately change it.
LISTEN_ADDR=0.0.0.0:8080

# Directory holding prompts.db. The server creates the file on first start.
DATA_DIR=/data

# --- reverse proxy ------------------------------------------------------------

# Read X-Real-IP to identify the visitor behind a reverse proxy. Default false.
#
# Leave this false unless the app port is reachable *only* through a proxy that
# overwrites X-Real-IP with the real connection address. When false, every
# forwarding header is ignored and the login throttle always charges the peer
# address.
#
# When true: the deployment MUST NOT publish the app port directly. Anyone able
# to reach the app port could set X-Real-IP themselves and get a fresh login
# quota per attempt. The login throttle charges the header only in this mode,
# and refuses the login if X-Real-IP is missing or is not a single valid IP
# (no falling back to the proxy's own address).
#
# The bundled compose.yaml sets this to true because the app service publishes
# no host port. X-Forwarded-For is never read.
TRUST_PROXY=false

# --- model (optional) ---------------------------------------------------------

# All three must be set for optimization to work. If any is missing the site
# still starts: login, library and schemes work, and new optimization requests
# return 503 model_not_configured. Leave all three empty to run without a model.
# The base URL is the OpenAI-compatible root; requests go to {LLM_BASE_URL}/chat/completions.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=replace-with-real-model-id

# Sampling parameters are fixed in the server (temperature 0.2, top_p 1,
# max_tokens 2048) and recorded on every run; they are not environment knobs.

# --- compose only -------------------------------------------------------------

# Domain Caddy serves and requests a certificate for. Must match APP_ORIGIN's
# host, and must already resolve to this host with ports 80/443 reachable.
APP_DOMAIN=prompts.example.com

# --- evaluation harness only (scripts/eval/run.mjs) ---------------------------
# Optional. These let the eval script call a different model than the one the
# site optimizes with. Not read by the server.

# EVAL_BASE_URL=https://api.example.com/v1
# EVAL_API_KEY=sk-replace-me
# EVAL_MODEL=replace-with-real-model-id
