# HTTPS reverse proxy for the optional Compose deployment.
#
# Replace the address with your real domain BEFORE starting: Caddy obtains a
# Let's Encrypt certificate automatically, which requires that the domain
# already resolves to this host and that ports 80 and 443 are reachable.
#
# X-Real-IP is set from the real connection address. The app charges the login
# throttle to this address when TRUST_PROXY=true, so this proxy must overwrite
# the header on every request: a client that could set it could forge a fresh
# quota per login attempt. Caddy's automatic HTTPS already sets
# X-Forwarded-Proto; the app reads neither that nor X-Forwarded-For.

{$APP_DOMAIN} {
	log {
		output stderr
		format console
	}

	# 1 MiB request bodies are the app's own limit; this is the outer guard.
	request_body {
		max_size 2MB
	}

	# The optimization request is synchronous and takes up to 90s. Caddy's
	# default has no read timeout, but keep the intent explicit for whoever
	# edits this file: do not add a shorter proxy timeout here.
	reverse_proxy app:8080 {
		# Overwrite, never append: a client-supplied value must not survive.
		header_up X-Real-IP {http.request.remote.host}
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}

	encode zstd gzip
}
